<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/list_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ALARMS"
        android:textColor="#4C8DFF"
        android:textSize="9sp"
        android:letterSpacing="0.15"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/row1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="#EDEFF3"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row1_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#9AA3B2" />

        <ImageView
            android:id="@+id/row1_toggle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Toggle alarm"
            android:padding="4dp"
            android:src="@drawable/widget_toggle_on" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/row2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="#EDEFF3"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row2_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#9AA3B2" />

        <ImageView
            android:id="@+id/row2_toggle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Toggle alarm"
            android:padding="4dp"
            android:src="@drawable/widget_toggle_on" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/row3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="#EDEFF3"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row3_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#9AA3B2" />

        <ImageView
            android:id="@+id/row3_toggle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Toggle alarm"
            android:padding="4dp"
            android:src="@drawable/widget_toggle_on" />
    </LinearLayout>
</LinearLayout>
