<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/hol_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HOLIDAYS"
        android:textColor="#4C8DFF"
        android:textSize="9sp"
        android:letterSpacing="0.15"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/hol1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/hol1"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#4C8DFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hol1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#EDEFF3" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hol2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/hol2"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#4C8DFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hol2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#EDEFF3" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/hol3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/hol3"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#4C8DFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hol3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#EDEFF3" />
    </LinearLayout>
</LinearLayout>
