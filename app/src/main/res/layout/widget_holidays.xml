<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad">

    <TextView
        android:id="@+id/hol_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_header_holidays"
        android:textColor="@color/widget_accent"
        android:textSize="9sp"
        android:letterSpacing="0.15"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/widget_gap" />

    <LinearLayout
        android:id="@+id/hol1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_gap"
        android:paddingBottom="@dimen/widget_gap">

        <TextView
            android:id="@+id/hol1"
            android:layout_width="@dimen/widget_date_column"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hol1_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hol2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_gap"
        android:paddingBottom="@dimen/widget_gap">

        <TextView
            android:id="@+id/hol2"
            android:layout_width="@dimen/widget_date_column"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hol2_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hol3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/widget_gap"
        android:paddingBottom="@dimen/widget_gap">

        <TextView
            android:id="@+id/hol3"
            android:layout_width="@dimen/widget_date_column"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/widget_accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hol3_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink" />
    </LinearLayout>
</LinearLayout>
